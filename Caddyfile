# ShareYouSee 反向代理配置
# 前后端分离:Caddy 负责对外 HTTPS + 静态资源 + 反代 ws/api 到 Fastify 后端。

# 公网/域名正式入口(ACME 自动签发 HTTPS)
share.armin.com.cn {
    encode zstd gzip

    # 静态资源(前端 SPA 产物):由 Caddy 直接托管
    root * /var/www/shareyousee/frontend-dist
    file_server

    # WebSocket 信令(/api/connect) + REST(/api/*) 反代到 Fastify 后端
    # Caddy 会自动处理 WebSocket 升级,无需显式 header_up
    reverse_proxy /api/* 127.0.0.1:3002

    # SPA fallback:history 路由兜底(注意:必须在 reverse_proxy 之后,否则会吞掉 /api)
    try_files {path} /index.html

    # 跨域:允许任意来源携带凭证请求,允许常见方法与自定义头
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Origin, Content-Type, Accept, Authorization, X-Requested-With"
        Access-Control-Max-Age "3600"
        defer
    }
}

# 局域网调试入口,仅监听内网 IP,无 TLS
http://192.168.1.3:3002 {
    root * /var/www/shareyousee/frontend-dist
    file_server

    reverse_proxy /api/* 127.0.0.1:3002

    try_files {path} /index.html
}